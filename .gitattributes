# Set default behavior to auto normalize
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=auto

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.safetensors binary
*.onnx binary
*.bin binary
*.pth binary
